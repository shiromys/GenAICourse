# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/genaicourse

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@genaicourse.io
ADMIN_PASSWORD=Admin@123

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email (Resend) — all transactional email (welcome, payment confirmation,
# certificates, password reset, login alerts) goes through Resend, not SMTP.
RESEND_API_KEY=your_resend_api_key

# Stripe
# STRIPE_WEBHOOK_KEY is NOT optional in production: the webhook handler
# (controllers/paymentController.js, POST /api/payments/webhook) refuses to
# process any event at all if this is missing, rather than trusting an
# unsigned request — so payments/enrollment will stop working, loudly, until
# this is set correctly. Get it from the Stripe Dashboard → Developers →
# Webhooks → your endpoint → "Signing secret" (starts with whsec_).
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_KEY=whsec_your_real_webhook_signing_secret
